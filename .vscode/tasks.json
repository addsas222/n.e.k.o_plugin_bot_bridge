{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bot_bridge: tests",
      "type": "shell",
      "command": "python -m pytest tests -q",
      "options": {"env": {"NEKO_SOURCE_ROOT": "${workspaceFolder}/../neko"}},
